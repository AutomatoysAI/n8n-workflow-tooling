              "type": "number",
              "value": "={{ ($json.last_chased_on ? Math.round(DateTime.fromISO('2026-09-02').diff(DateTime.fromISO($json.last_chased_on), 'days').days) : 9999) }}"
            },
            {
              "id": "a6",
              "name": "days_since_reply",
              "type": "number",
              "value": "={{ ($json.last_reply_on ? Math.round(DateTime.fromISO('2026-09-02').diff(DateTime.fromISO($json.last_reply_on), 'days').days) : 9999) }}"
            },
            {
              "id": "a7",
              "name": "chase_number",
              "type": "number",
              "value": "={{ $json.chase_count + 1 }}"
            }
          ]
