              "value": "={{ [[\"a signed engagement letter\", $json.engagement_letter], [\"photo ID\", $json.photo_id], [\"proof of address\", $json.proof_of_address], [\"your company details\", $json.company_details], [\"your previous accountant's details\", $json.previous_accountant]].filter(i => !i[1]).map(i => i[0]).join(', ') }}"
            },
            {
              "id": "a2",
              "name": "outstanding_count",
              "type": "number",
              "value": "={{ [[\"a signed engagement letter\", $json.engagement_letter], [\"photo ID\", $json.photo_id], [\"proof of address\", $json.proof_of_address], [\"your company details\", $json.company_details], [\"your previous accountant's details\", $json.previous_accountant]].filter(i => !i[1]).length }}"
            },
            {
              "id": "a3",
              "name": "received",
              "type": "string",
              "value": "={{ [[\"a signed engagement letter\", $json.engagement_letter], [\"photo ID\", $json.photo_id], [\"proof of address\", $json.proof_of_address], [\"your company details\", $json.company_details], [\"your previous accountant's details\", $json.previous_accountant]].filter(i => i[1]).map(i => i[0]).join(', ') }}"
            },
            {
              "id": "a4",
              "name": "days_since_request",
              "type": "number",
              "value": "={{ Math.round(DateTime.fromISO('2026-09-02').diff(DateTime.fromISO($json.requested_on), 'days').days) }}"
            },
            {
