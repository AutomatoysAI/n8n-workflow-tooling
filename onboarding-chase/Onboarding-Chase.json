            "Reference": "={{ $('What Does the Policy Say?').item.json.client_id }}",
            "Decision": "={{ $('What Does the Policy Say?').item.json.todays_decision }}",
            "Detail": "={{ $('What Does the Policy Say?').item.json.todays_decision === 'Time for a nudge' ? ('Reminder ' + $('What Does the Policy Say?').item.json.chase_number + ' sent to ' + $('What Does the Policy Say?').item.json.contact_email) : $('What Does the Policy Say?').item.json.todays_decision === 'Everything is in' ? 'All five items received. File closed for partner sign-off.' : $('What Does the Policy Say?').item.json.todays_decision === 'Three nudges and no answer' ? ('Chasing stopped after ' + $('What Does the Policy Say?').item.json.chase_count + ' reminders. Passed to ' + $('What Does the Policy Say?').item.json.account_owner) : ('Considered and not chased: ' + $('What Does the Policy Say?').item.json.todays_decision.toLowerCase()) }}",
            "Still Outstanding": "={{ $('What Does the Policy Say?').item.json.outstanding || 'nothing' }}",
            "Days Since Request": "={{ $('What Does the Policy Say?').item.json.days_since_request }}",
            "Reminders Sent": "={{ $('What Does the Policy Say?').item.json.chase_count }}",
            "Decided By": "={{ $('What Does the Policy Say?').item.json.todays_decision === 'Three nudges and no answer' ? ('Rule, then handed to ' + $('What Does the Policy Say?').item.json.account_owner) : 'Automatic - onboarding chase rule' }}"
          }
        },
        "options": {}
