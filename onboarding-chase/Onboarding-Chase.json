              "id": "a1",
              "name": "todays_decision",
              "type": "string",
              "value": "={{\n  $json.outstanding_count === 0                                    ? 'Everything is in'\n  : $json.days_since_reply <= 1                                    ? 'They replied yesterday'\n  : ($json.chase_count >= 3 && $json.days_since_last_chase >= 3) ? 'Three nudges and no answer'\n  : $json.days_since_last_chase < 3                               ? 'Too soon since the last nudge'\n  : $json.days_since_request < 3                                  ? 'Only just asked'\n  :                                                                  'Time for a nudge'\n}}"
            }
          ]
        },
