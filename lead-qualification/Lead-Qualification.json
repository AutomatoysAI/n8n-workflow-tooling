    {
      "parameters": {
        "promptType": "define",
        "text": "=Write the first reply to this enquiry, from Ade Fanshawe at Latchford Cooling, commercial refrigeration and air conditioning - installation, planned servicing and 24-hour breakdown cover.\n\nRules:\n- Four short paragraphs at most. No greeting longer than one line.\n- Answer what they actually asked, in their own terms.\n- **Do not quote a price, a lead time, an install date or a discount.** You do not have that information and Ade does. Say he will confirm it.\n- Do not promise anything about availability or engineers.\n- Ask at most one question, and only if the enquiry cannot move without it.\n- No marketing language. Plain, quick, useful.\n\nTHEIR ENQUIRY:\n{{ $('Score the Lead').item.json.message }}\n\nWHAT THEY WANT: {{ $('Score the Lead').item.json.wants }}",
        "messages": {
          "messageValues": []
        }
      },
      "id": "f1000000-0000-4000-8000-000000000015",
      "name": "Write the Reply for Ade",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [
        -460,
        0
      ]
    },
    {
      "parameters": {
        "resource": "draft",
        "subject": "=Re: your enquiry about {{ $('Score the Lead').item.json.wants }}",
        "emailType": "text",
        "message": "={{ $json.text }}",
        "options": {
          "sendTo": "={{ $('Score the Lead').item.json.email }}"
        }
      },
      "id": "f1000000-0000-4000-8000-000000000016",
      "name": "Save It as a Draft",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
