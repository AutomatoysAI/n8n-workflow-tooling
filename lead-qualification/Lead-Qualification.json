            },
            {
              "id": "a7",
              "name": "company",
              "type": "string",
              "value": "={{ $('Read the Form as a Lead').item.json.company }}"
            },
            {
              "id": "a8",
              "name": "region",
              "type": "string",
              "value": "={{ $('Read the Form as a Lead').item.json.region }}"
            },
            {
              "id": "a9",
              "name": "budget_band",
              "type": "string",
              "value": "={{ $('Read the Form as a Lead').item.json.budget_band }}"
            },
            {
              "id": "a10",
              "name": "timeline",
              "type": "string",
              "value": "={{ $('Read the Form as a Lead').item.json.timeline }}"
            },
            {
              "id": "a11",
              "name": "message",
              "type": "string",
              "value": "={{ $('Read the Form as a Lead').item.json.message }}"
            },
            {
              "id": "a12",
              "name": "enquiry_type",
              "type": "string",
              "value": "={{ (($json.output || {}).enquiry_type || 'other') }}"
            },
            {
              "id": "a13",
              "name": "wants",
              "type": "string",
              "value": "={{ ($json.output || {}).wants || '' }}"
            },
            {
              "id": "a14",
              "name": "evidence",
              "type": "string",
              "value": "={{ ($json.output || {}).evidence || '' }}"
            },
            {
              "id": "a15",
              "name": "in_service_area",
              "type": "string",
              "value": "={{ ([\"East Midlands\", \"West Midlands\", \"Yorkshire\", \"North West\", \"North East\"].includes($('Read the Form as a Lead').item.json.region)) ? 'yes' : 'no' }}"
            },
            {
              "id": "a16",
              "name": "budget_worth_chasing",
              "type": "string",
              "value": "={{ ([\"\\u00a310,000 - \\u00a350,000\", \"Over \\u00a350,000\"].includes($('Read the Form as a Lead').item.json.budget_band)) ? 'yes' : 'no' }}"
            },
            {
              "id": "a17",
              "name": "wants_it_soon",
              "type": "string",
              "value": "={{ ([\"Within a month\", \"1 - 3 months\"].includes($('Read the Form as a Lead').item.json.timeline)) ? 'yes' : 'no' }}"
            },
            {
              "id": "a18",
              "name": "tier",
              "type": "string",
              "value": "={{ !([\"new_project\", \"existing_customer\"].includes((($json.output || {}).enquiry_type || 'other'))) ? 'Not a fit' : (!([\"East Midlands\", \"West Midlands\", \"Yorkshire\", \"North West\", \"North East\"].includes($('Read the Form as a Lead').item.json.region)) ? 'Needs a person' : (([\"\\u00a310,000 - \\u00a350,000\", \"Over \\u00a350,000\"].includes($('Read the Form as a Lead').item.json.budget_band) && [\"Within a month\", \"1 - 3 months\"].includes($('Read the Form as a Lead').item.json.timeline)) ? 'Hot' : 'Warm')) }}"
            },
            {
              "id": "a19",
              "name": "why",
              "type": "string",
              "value": "={{ !([\"new_project\", \"existing_customer\"].includes((($json.output || {}).enquiry_type || 'other'))) ? ('The message is ' + ((($json.output || {}).enquiry_type || 'other') === 'job_application' ? 'a job application' : ((($json.output || {}).enquiry_type || 'other') === 'supplier_or_pitch' ? 'somebody selling to us' : 'not an enquiry')) + ', whatever the form says.') : (!([\"East Midlands\", \"West Midlands\", \"Yorkshire\", \"North West\", \"North East\"].includes($('Read the Form as a Lead').item.json.region)) ? ('A real project worth having, but ' + $('Read the Form as a Lead').item.json.region + ' is outside the service area.') : (([\"\\u00a310,000 - \\u00a350,000\", \"Over \\u00a350,000\"].includes($('Read the Form as a Lead').item.json.budget_band) && [\"Within a month\", \"1 - 3 months\"].includes($('Read the Form as a Lead').item.json.timeline)) ? (((($json.output || {}).enquiry_type || 'other') === 'existing_customer' ? 'Existing customer, ' : 'New enquiry, ') + $('Read the Form as a Lead').item.json.budget_band + ', wants it ' + $('Read the Form as a Lead').item.json.timeline + '.') : 'A real enquiry, but no budget or date attached to it yet.')) }}"
            }
          ]
        },
        "options": {}
      },
