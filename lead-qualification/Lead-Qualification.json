    {
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "=Thanks for getting in touch with Latchford Cooling",
        "emailType": "text",
        "message": "=Hi {{ $json.name.split(' ')[0] }},\n\nThanks for your enquiry about {{ $json.source_page.replace('/', '').replace(/-/g, ' ') }}. It has reached the right team and {{ $('Score the Lead').item.json.tier === 'Warm' ? 'someone will come back to you within two working days' : 'someone will be in touch' }}.\n\nIf it is urgent in the meantime, our breakdown line is open 24 hours.\n\nAde Fanshawe\nLatchford Cooling",
        "options": {}
      },
      "id": "f1000000-0000-4000-8000-000000000017",
      "name": "Send the Acknowledgement",
      "type": "n8n-nodes-base.gmail",
