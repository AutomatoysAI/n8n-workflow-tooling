    {
      "parameters": {
        "promptType": "define",
        "text": "=Write one reactivation message for a past customer of Northgate Auto Care, using only the facts below.\n\nfirst_name: {{ $json.first_name }}\nvehicle: {{ $json.vehicle }}\nlast_service_type: {{ $json.last_service_type }}\nmonths_since: {{ $json.months_since_service }}\noffer (use exactly, do not improve): $30 off any service booked before 30 September\n\nReference the specific thing they last had done and roughly how long ago - that is what makes it\nworth reading. State the offer once. Give one easy next step.\n\nNever invent a discount, price, deadline, service or anything about their vehicle. No exclamation\nmarks, no \"we miss you\", no marketing adjectives. Write like the shop owner would.\n\nTHIS ONE IS A TEXT MESSAGE.\nUnder 300 characters in total. Open with the business name so they know who it is.\nEnd with exactly: Reply STOP to opt out\nReturn the message only - no subject line, no notes.",
        "messages": {
          "messageValues": []
        }
      },
      "id": "e5000000-0000-4000-8000-000000000011",
      "name": "Write the Text Message",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [
        -400,
        -60
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Write one reactivation message for a past customer of Northgate Auto Care, using only the facts below.\n\nfirst_name: {{ $json.first_name }}\nvehicle: {{ $json.vehicle }}\nlast_service_type: {{ $json.last_service_type }}\nmonths_since: {{ $json.months_since_service }}\noffer (use exactly, do not improve): $30 off any service booked before 30 September\n\nReference the specific thing they last had done and roughly how long ago - that is what makes it\nworth reading. State the offer once. Give one easy next step.\n\nNever invent a discount, price, deadline, service or anything about their vehicle. No exclamation\nmarks, no \"we miss you\", no marketing adjectives. Write like the shop owner would.\n\nTHIS ONE IS AN EMAIL.\nUnder 120 words. Sign off with the business name.\nIf they have been gone more than two years, give them an easy way to say they have moved on.\nReturn the body only - the subject line is added separately.",
        "messages": {
          "messageValues": []
        }
      },
      "id": "e5000000-0000-4000-8000-000000000012",
      "name": "Write the Email",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [
        -400,
        180
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "k1",
              "leftValue": "={{ $json.text.length }}",
              "rightValue": 300,
              "operator": {
                "type": "number",
                "operation": "lte"
              }
            },
            {
              "id": "k2",
              "leftValue": "={{ $json.text }}",
              "rightValue": "Reply STOP to opt out",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            },
            {
              "id": "k3",
              "leftValue": "={{ $json.text }}",
              "rightValue": "\\$(?!30\\b)\\d|\\d+\\s?%",
              "operator": {
                "type": "string",
                "operation": "notRegex"
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "e5000000-0000-4000-8000-000000000013",
      "name": "Does the Text Pass?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -160,
        -60
      ]
    },
