        "text": "=*Ready to post* - {{ $('Assemble the Post').item.json.post_kind }} for {{ $('Assemble the Post').item.json.line_2 }}\n{{ $('Assemble the Post').item.json.line_1 }} - {{ $('Assemble the Post').item.json.line_3 }} ({{ $('Assemble the Post').item.json.our_role }})\n{{ $('Assemble the Post').item.json.image_source ? 'Our own listing photo.' : '_No listing photo - not our transaction, so the template runs on our own artwork._' }}\n> {{ $('Write the Caption').item.json.text }}\n{{ $json.image_url }}",
        "otherOptions": {}
      },
