          "assignments": [
            {
              "id": "a1",
              "name": "qualifies",
              "type": "boolean",
              "value": "={{ $json.city === \"Toronto\" && (($json.status === 'Sold' && $json.price >= 4000000) || ($json.status === 'New Listing' && $json.price >= 5000000)) }}"
            },
            {
              "id": "a2",
