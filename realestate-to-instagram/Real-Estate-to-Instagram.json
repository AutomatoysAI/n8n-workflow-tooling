            },
            {
              "id": "a4",
              "name": "price_is_ours_to_show",
              "type": "boolean",
              "value": "={{ ($json.we_listed_it || $json.we_repped_the_buyer) }}"
            },
            {
              "id": "a5",
              "name": "price_display",
              "type": "string",
              "value": "={{ ($json.we_listed_it || $json.we_repped_the_buyer) ? '$' + ($json.price / 1000000).toFixed(2).replace(/\\.?0+$/, '') + 'M' : '$' + ((Math.floor($json.price / 500000) * 500000) / 1000000).toFixed(1) + 'M-$' + ((Math.floor($json.price / 500000) * 500000 + 500000) / 1000000).toFixed(1) + 'M' }}"
            },
            {
              "id": "a6",
              "name": "our_role",
              "type": "string",
              "value": "={{ $json.we_listed_it ? 'Listing brokerage' : ($json.we_repped_the_buyer ? 'Buyer representation' : 'Not our transaction') }}"
            },
            {
              "id": "a7",
              "name": "skip_reason",
              "type": "string",
              "value": "={{ $json.posted_at ? ('Already published on ' + $json.posted_at) : ($json.city !== \"Toronto\" ? 'Outside Toronto' : (($json.city === \"Toronto\" && (($json.status === 'Sold' && $json.price >= 4000000) || ($json.status === 'New Listing' && $json.price >= 5000000))) ? '' : 'Under the threshold')) }}"
            }
          ]
        },
        "options": {}
      },
      "id": "b3000000-0000-4000-8000-000000000009",
      "name": "What Are We Allowed to Publish?",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -1140,
        100
      ]
    },
    {
