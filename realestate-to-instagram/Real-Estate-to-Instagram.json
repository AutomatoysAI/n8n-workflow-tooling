              "value": "={{ $json.listing_brokerage === \"Kingsway Ellis Realty Inc., Brokerage\" }}"
            },
            {
              "id": "a5",
              "name": "we_repped_the_buyer",
              "type": "boolean",
              "value": "={{ $json.buyer_brokerage === \"Kingsway Ellis Realty Inc., Brokerage\" }}"
