        "joinMode": "enrichInput1",
        "options": {}
      },
      "id": "c4000000-0000-4000-8000-000000000010",
      "name": "Match the Books to Shopify",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        -1200,
        0
      ]
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByFields",
        "fieldsToMatchString": "date",
        "joinMode": "enrichInput1",
        "options": {}
      },
      "id": "c4000000-0000-4000-8000-000000000011",
      "name": "Add the Ad Spend",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        -980,
        140
      ]
    },
    {
      "parameters": {
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "orders",
              "type": "number",
              "value": "={{ $json.count_order_number }}"
            },
            {
              "id": "a2",
              "name": "gross_sales",
              "type": "number",
              "value": "={{ Math.round(($json.sum_total_price) * 100) / 100 }}"
            },
            {
              "id": "a3",
              "name": "refunds",
              "type": "number",
              "value": "={{ Math.round(($json.sum_refund_amount) * 100) / 100 }}"
            },
            {
              "id": "a4",
              "name": "shopify_net",
              "type": "number",
              "value": "={{ Math.round((($json.sum_total_price - $json.sum_refund_amount - $json.sum_tax - $json.sum_shipping)) * 100) / 100 }}"
            },
            {
              "id": "a5",
              "name": "books_net",
              "type": "number",
              "value": "={{ Math.round(($json.booked_net_revenue) * 100) / 100 }}"
            },
            {
              "id": "a6",
              "name": "gap",
              "type": "number",
              "value": "={{ Math.round(((($json.sum_total_price - $json.sum_refund_amount - $json.sum_tax - $json.sum_shipping) - $json.booked_net_revenue)) * 100) / 100 }}"
            },
            {
              "id": "a7",
              "name": "explained_by_gift_cards",
              "type": "number",
              "value": "={{ Math.round(($json.sum_gift_card) * 100) / 100 }}"
            },
            {
              "id": "a8",
              "name": "unexplained",
              "type": "number",
              "value": "={{ Math.round((Math.abs((($json.sum_total_price - $json.sum_refund_amount - $json.sum_tax - $json.sum_shipping) - $json.booked_net_revenue) - $json.sum_gift_card)) * 100) / 100 }}"
            },
            {
              "id": "a9",
              "name": "unexplained_pct",
              "type": "number",
              "value": "={{ (Math.round((Math.abs((($json.sum_total_price - $json.sum_refund_amount - $json.sum_tax - $json.sum_shipping) - $json.booked_net_revenue) - $json.sum_gift_card) / ($json.sum_total_price - $json.sum_refund_amount - $json.sum_tax - $json.sum_shipping)) * 1000) / 10) }}"
            },
            {
              "id": "a10",
              "name": "number_of_record",
              "type": "number",
              "value": "={{ Math.round(($json.booked_net_revenue) * 100) / 100 }}"
            },
            {
              "id": "a11",
              "name": "aov",
              "type": "number",
              "value": "={{ Math.round(($json.booked_net_revenue / $json.count_order_number) * 100) / 100 }}"
            },
            {
              "id": "a12",
              "name": "ad_spend",
              "type": "number",
              "value": "={{ Math.round(($json.spend) * 100) / 100 }}"
            },
            {
              "id": "a13",
              "name": "blended_roas",
              "type": "number",
              "value": "={{ Math.round(($json.booked_net_revenue / $json.spend) * 100) / 100 }}"
            },
            {
              "id": "a14",
              "name": "meta_claimed_revenue",
              "type": "number",
              "value": "={{ Math.round(($json.attributed_revenue) * 100) / 100 }}"
            },
            {
              "id": "a15",
              "name": "meta_claim_pct",
              "type": "number",
              "value": "={{ Math.round(($json.attributed_revenue / $json.booked_net_revenue) * 1000) / 10 }}"
            },
            {
              "id": "a16",
              "name": "reconciliation_note",
              "type": "string",
              "value": "={{ Math.abs((($json.sum_total_price - $json.sum_refund_amount - $json.sum_tax - $json.sum_shipping) - $json.booked_net_revenue) - $json.sum_gift_card) === 0 ? ('Shopify and the books differ by $' + (($json.sum_total_price - $json.sum_refund_amount - $json.sum_tax - $json.sum_shipping) - $json.booked_net_revenue) + ', which is exactly the gift cards redeemed. A redeemed gift card is not new revenue - it was booked when the card was sold.') : ('Shopify and the books differ by $' + (($json.sum_total_price - $json.sum_refund_amount - $json.sum_tax - $json.sum_shipping) - $json.booked_net_revenue) + '. Gift cards account for $' + $json.sum_gift_card + '. $' + Math.abs((($json.sum_total_price - $json.sum_refund_amount - $json.sum_tax - $json.sum_shipping) - $json.booked_net_revenue) - $json.sum_gift_card) + ' is unaccounted for.') }}"
            }
          ]
        },
        "options": {}
      },
      "id": "c4000000-0000-4000-8000-000000000012",
      "name": "Reconcile the Numbers",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -760,
        140
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "g1",
              "leftValue": "={{ $json.unexplained_pct }}",
              "rightValue": 1.0,
              "operator": {
                "type": "number",
                "operation": "lte"
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "c4000000-0000-4000-8000-000000000013",
      "name": "Do the Numbers Agree?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -520,
        140
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-4.1-mini",
          "mode": "list",
          "cachedResultName": "gpt-4.1-mini"
        },
        "options": {
          "temperature": 0.2,
          "maxTokens": 500
        }
      },
      "id": "c4000000-0000-4000-8000-000000000014",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        -280,
        280
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Write Renata Alvim, the CEO of Copperleaf Goods, a short morning note about yesterday's trading.\n\nDATE: {{ $json.date }}\nREVENUE (the number of record, from the books): ${{ $json.number_of_record }}\nORDERS: {{ $json.orders }}\nAVERAGE ORDER VALUE: ${{ $json.aov }}\nGROSS SALES IN SHOPIFY: ${{ $json.gross_sales }}\nREFUNDS: ${{ $json.refunds }}\nRECONCILIATION: {{ $json.reconciliation_note }}\nAD SPEND (Meta): ${{ $json.ad_spend }}\nBLENDED ROAS (revenue of record / ad spend): {{ $json.blended_roas }}\nMETA SAYS IT DROVE: ${{ $json.meta_claimed_revenue }} ({{ $json.meta_claim_pct }}% of revenue)\n\nRules:\n- **Revenue is the number of record and nothing else.** Never quote the Shopify gross as\n  revenue, and never add Meta's attributed figure to anything.\n- **Meta's number is a claim, not an accounting fact.** If you mention it, say whose claim\n  it is. The platform counts a sale as its own if the buyer saw an ad within its window,\n  and other channels claim the same sales, so these figures overlap and cannot be summed.\n- Mention the reconciliation in one sentence, in plain words. Renata is not an accountant\n  and should not have to be.\n- **Never state a fact that is not listed above.** No comparison to last week, last month\n  or target - you have not been given them, and an invented trend is worse than no trend.\n- No recommendations. This is a status note, not advice.\n- Four sentences or fewer. No greeting, no sign-off, no bullet points, no exclamation\n  marks. Plain sentences a person reads standing up.\n\nReturn the note only.",
        "messages": {
          "messageValues": []
        }
      },
      "id": "c4000000-0000-4000-8000-000000000015",
      "name": "Write the Briefing",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [
        -280,
        40
      ]
    },
    {
      "parameters": {
        "sendTo": "renata@copperleafgoods.example",
        "subject": "={{ 'Yesterday: $' + $('Reconcile the Numbers').item.json.number_of_record + ' across ' + $('Reconcile the Numbers').item.json.orders + ' orders' }}",
        "message": "={{ $json.text }}",
        "options": {}
      },
      "id": "c4000000-0000-4000-8000-000000000016",
      "name": "Email the CEO",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        -40,
        40
      ],
      "disabled": true
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "finance-alerts",
          "mode": "name"
        },
        "text": "=*No briefing sent for {{ $json.date }}* - the numbers do not reconcile.\nShopify nets *${{ $json.shopify_net }}*, the books say *${{ $json.books_net }}*.\nGift cards explain ${{ $json.explained_by_gift_cards }}. *${{ $json.unexplained }} ({{ $json.unexplained_pct }}%) is unaccounted for*, against a 1.0% tolerance.\n{{ $json.orders }} orders. Usual suspects: a channel that has not settled, a failed sync, or a day cut on a different timezone.\n<@Ade Balogun - Finance> - nothing has gone to Renata.",
        "otherOptions": {}
      },
      "id": "c4000000-0000-4000-8000-000000000017",
      "name": "Hold It and Ask Finance",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [
        -40,
        320
      ],
      "disabled": true
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEET_ID_HERE",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Daily",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Date": "={{ $('Reconcile the Numbers').item.json.date }}",
            "Revenue (books)": "={{ $('Reconcile the Numbers').item.json.number_of_record }}",
            "Shopify net": "={{ $('Reconcile the Numbers').item.json.shopify_net }}",
            "Unexplained": "={{ $('Reconcile the Numbers').item.json.unexplained }}",
            "Orders": "={{ $('Reconcile the Numbers').item.json.orders }}",
            "AOV": "={{ $('Reconcile the Numbers').item.json.aov }}",
            "Ad spend": "={{ $('Reconcile the Numbers').item.json.ad_spend }}",
            "Blended ROAS": "={{ $('Reconcile the Numbers').item.json.blended_roas }}",
            "Sent": "={{ $('Reconcile the Numbers').item.json.unexplained_pct <= 1.0 ? 'Yes' : 'Held' }}"
          }
        },
        "options": {}
      },
      "id": "c4000000-0000-4000-8000-000000000018",
      "name": "Log the Day",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        200,
        140
      ],
      "disabled": true
    }
