              "field": "order_number"
            }
          ]
        },
        "fieldsToSplitBy": "date",
        "options": {}
      },
      "id": "c4000000-0000-4000-8000-000000000009",
      "name": "Total Up Shopify",
      "type": "n8n-nodes-base.summarize",
      "typeVersion": 1.1,
      "position": [
        -1420,
        -100
      ]
    },
    {
