            },
            {
              "id": "a12",
              "name": "broken_channels",
              "type": "string",
              "value": "={{ $json.channels.filter(c => c.looks_broken).map(c => c.channel).join(', ') }}"
            }
          ]
        },
        "options": {}
      },
