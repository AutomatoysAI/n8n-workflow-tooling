        "url": "https://searchconsole.googleapis.com/webmasters/v3/sites/YOUR_SITE/searchAnalytics/query",
        "method": "POST",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"startDate\": \"{{ $now.minus({ months: 1 }).startOf('month').toISODate() }}\",\n  \"endDate\": \"{{ $now.minus({ months: 1 }).endOf('month').toISODate() }}\",\n  \"dimensions\": [\"date\"]\n}",
        "options": {}
      },
