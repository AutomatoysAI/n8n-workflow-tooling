            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.client }}",
              "rightValue": "={{ $('One Client at a Time').first().json.client }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "a7000000-0000-4000-8000-000000000011",
      "name": "Just This Client",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        -1260,
        160
      ]
    },
    {
      "parameters": {
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "conversions_mom_pct",
              "type": "number",
              "value": "={{ $json.conversions_prev > 0 ? Math.round((($json.conversions - $json.conversions_prev) / $json.conversions_prev) * 1000) / 10 : 0 }}"
            },
            {
              "id": "a2",
              "name": "conversions_yoy_pct",
              "type": "number",
              "value": "={{ $json.conversions_last_year > 0 ? Math.round((($json.conversions - $json.conversions_last_year) / $json.conversions_last_year) * 1000) / 10 : 0 }}"
            },
            {
              "id": "a3",
              "name": "spend_mom_pct",
              "type": "number",
              "value": "={{ $json.spend_prev > 0 ? Math.round((($json.spend - $json.spend_prev) / $json.spend_prev) * 1000) / 10 : 0 }}"
            },
            {
              "id": "a4",
              "name": "vs_target_pct",
              "type": "number",
              "value": "={{ $json.target_conversions > 0 ? Math.round((($json.conversions - $json.target_conversions) / $json.target_conversions) * 1000) / 10 : 0 }}"
            },
            {
              "id": "a5",
              "name": "cpa",
              "type": "number",
              "value": "={{ Math.round((($json.spend > 0 && $json.conversions > 0 ? $json.spend / $json.conversions : 0)) * 100) / 100 }}"
            },
            {
              "id": "a6",
              "name": "cpa_prev",
              "type": "number",
              "value": "={{ Math.round((($json.spend_prev > 0 && $json.conversions_prev > 0 ? $json.spend_prev / $json.conversions_prev : 0)) * 100) / 100 }}"
            },
            {
              "id": "a7",
              "name": "cpa_change_pct",
              "type": "number",
              "value": "={{ (($json.spend_prev > 0 && $json.conversions_prev > 0 ? $json.spend_prev / $json.conversions_prev : 0)) > 0 ? Math.round((((($json.spend > 0 && $json.conversions > 0 ? $json.spend / $json.conversions : 0)) - (($json.spend_prev > 0 && $json.conversions_prev > 0 ? $json.spend_prev / $json.conversions_prev : 0))) / (($json.spend_prev > 0 && $json.conversions_prev > 0 ? $json.spend_prev / $json.conversions_prev : 0))) * 1000) / 10 : 0 }}"
            },
            {
              "id": "a8",
              "name": "ctr",
              "type": "number",
              "value": "={{ $json.impressions > 0 ? Math.round(($json.clicks / $json.impressions) * 10000) / 100 : 0 }}"
            },
            {
              "id": "a9",
              "name": "ctr_prev",
              "type": "number",
              "value": "={{ $json.impressions_prev > 0 ? Math.round(($json.clicks_prev / $json.impressions_prev) * 10000) / 100 : 0 }}"
            },
            {
              "id": "a10",
              "name": "looks_broken",
              "type": "boolean",
              "value": "={{ $json.spend_prev > 0 && $json.spend == 0 && $json.impressions == 0 }}"
            },
            {
              "id": "a11",
              "name": "movement",
              "type": "number",
              "value": "={{ Math.abs($json.conversions_prev > 0 ? Math.round((($json.conversions - $json.conversions_prev) / $json.conversions_prev) * 1000) / 10 : 0) }}"
            }
          ]
        },
        "options": {}
      },
      "id": "a7000000-0000-4000-8000-000000000012",
