        "subject": "={{ $('Build the Numbers Table').first().json.client_name }} - August 2026 report",
        "emailType": "text",
        "message": "={{ $json.text }}\n\n---\n\n{{ $('Build the Numbers Table').first().json.numbers_table }}",
        "options": {
