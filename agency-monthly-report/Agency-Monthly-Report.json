      "id": "a7000000-0000-4000-8000-000000000022",
      "name": "Full Report - Draft for Approval",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        500,
        280
      ],
      "disabled": true
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "reporting-review",
          "mode": "name"
        },
        "text": "=*No August 2026 report for {{ $('Build the Numbers Table').first().json.client_name }}*\n{{ $('Build the Numbers Table').first().json.broken_channels ? ('*' + $('Build the Numbers Table').first().json.broken_channels + '* spent money last month and reported nothing at all this month - zero spend, zero impressions. That is a broken connection until someone confirms otherwise, so no commentary was written and the client-facing numbers were not updated.') : ('The draft mentioned a channel this client does not run. Held rather than sent.') }}\nUsual causes: a revoked token, an expired refresh, or agency access removed inside the ad account.\n{{ $('Build the Numbers Table').first().json.account_manager }} - nothing has gone to the client.",
        "otherOptions": {}
      },
      "id": "a7000000-0000-4000-8000-000000000023",
      "name": "Held for a Person",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [
        500,
        560
      ],
      "disabled": true
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "YOUR_ROSTER_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Report log",
          "mode": "name"
        },
        "columns": {
