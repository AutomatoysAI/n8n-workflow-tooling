          "assignments": [
            {
              "id": "a1",
              "name": "exception_table",
              "type": "string",
              "value": "={{ $json.exceptions.map(o => o.lane + '  |  ' + o.order_number + '  |  ' + o.customer + ', ' + o.destination_country + ' (' + o.zone + ')' + '  |  ' + (o.carrier || 'no courier yet') + ' ' + (o.tracking_number || 'no tracking number') + '  |  last scan ' + (o.scan_at ? (o.scan_at.slice(0, 10) + ' - ' + o.scan_status + ', ' + o.scan_location) : 'never') + '  |  ' + o.why + '  |  ' + (o.reported_before > 0 ? ('already reported on ' + o.reported_before + ' previous mornings') : 'first appeared today')).join('\\n') }}"
            },
            {
              "id": "a2",
              "name": "open_orders",
              "type": "number",
              "value": "={{ $('Work Out What Changed').all().length }}"
            },
            {
              "id": "a3",
              "name": "needing_attention",
              "type": "number",
              "value": "={{ $json.exceptions.length }}"
            },
            {
              "id": "a4",
              "name": "repeats",
              "type": "number",
              "value": "={{ $json.exceptions.filter(o => o.reported_before > 0).length }}"
            },
            {
              "id": "a5",
              "name": "morning",
              "type": "string",
              "value": "2026-09-09"
            }
          ]
        },
