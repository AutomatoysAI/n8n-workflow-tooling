    {
      "parameters": {
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "days_since_order",
              "type": "number",
              "value": "={{ Math.floor(DateTime.fromISO('2026-09-09T08:00:00').diff(DateTime.fromISO($json.placed_at), 'days').days) }}"
            },
            {
              "id": "a2",
              "name": "days_in_transit",
              "type": "number",
              "value": "={{ ($json.shipped_at ? Math.floor(DateTime.fromISO('2026-09-09T08:00:00').diff(DateTime.fromISO($json.shipped_at), 'days').days) : -1) }}"
            },
            {
              "id": "a3",
              "name": "days_since_scan",
              "type": "number",
              "value": "={{ ($json.scan_at ? Math.floor(DateTime.fromISO('2026-09-09T08:00:00').diff(DateTime.fromISO($json.scan_at), 'days').days) : -1) }}"
            },
            {
              "id": "a4",
              "name": "days_overdue",
              "type": "number",
              "value": "={{ ($json.shipped_at ? Math.max(0, Math.floor(DateTime.fromISO('2026-09-09T08:00:00').diff(DateTime.fromISO($json.shipped_at), 'days').days) - $json.service_days) : 0) }}"
            },
            {
              "id": "a5",
              "name": "cost_ratio",
              "type": "number",
              "value": "={{ ($json.quoted_shipping > 0 && $json.invoiced_shipping ? Math.round(($json.invoiced_shipping / $json.quoted_shipping) * 100) / 100 : 0) }}"
            },
            {
              "id": "a6",
              "name": "moved_since_yesterday",
              "type": "boolean",
              "value": "={{ !!$json.scan_at && !!$json.snap_scan_at && $json.scan_at != $json.snap_scan_at }}"
            },
            {
              "id": "a7",
              "name": "reported_before",
              "type": "number",
              "value": "={{ $json.snap_mornings_reported || 0 }}"
            },
            {
              "id": "a8",
              "name": "lane",
              "type": "string",
              "value": "={{ ($json.fulfilled && !$json.scan_at && !!$json.snap_scan_at) ? 'Courier silent' : (!($json.fulfilled && !$json.scan_at && !!$json.snap_scan_at) && ((!$json.fulfilled && Math.floor(DateTime.fromISO('2026-09-09T08:00:00').diff(DateTime.fromISO($json.placed_at), 'days').days) > $json.handover_days) || (!!$json.scan_at && ($json.scan_at ? Math.floor(DateTime.fromISO('2026-09-09T08:00:00').diff(DateTime.fromISO($json.scan_at), 'days').days) : -1) >= 4) || (($json.shipped_at ? Math.max(0, Math.floor(DateTime.fromISO('2026-09-09T08:00:00').diff(DateTime.fromISO($json.shipped_at), 'days').days) - $json.service_days) : 0) >= 3))) ? 'Stuck' : (($json.quoted_shipping > 0 && $json.invoiced_shipping ? Math.round(($json.invoiced_shipping / $json.quoted_shipping) * 100) / 100 : 0) >= 1.4) ? 'Costs more than quoted' : (!($json.fulfilled && !$json.scan_at && !!$json.snap_scan_at) && !(!($json.fulfilled && !$json.scan_at && !!$json.snap_scan_at) && ((!$json.fulfilled && Math.floor(DateTime.fromISO('2026-09-09T08:00:00').diff(DateTime.fromISO($json.placed_at), 'days').days) > $json.handover_days) || (!!$json.scan_at && ($json.scan_at ? Math.floor(DateTime.fromISO('2026-09-09T08:00:00').diff(DateTime.fromISO($json.scan_at), 'days').days) : -1) >= 4) || (($json.shipped_at ? Math.max(0, Math.floor(DateTime.fromISO('2026-09-09T08:00:00').diff(DateTime.fromISO($json.shipped_at), 'days').days) - $json.service_days) : 0) >= 3))) && !(($json.quoted_shipping > 0 && $json.invoiced_shipping ? Math.round(($json.invoiced_shipping / $json.quoted_shipping) * 100) / 100 : 0) >= 1.4) && (($json.scan_at ? Math.floor(DateTime.fromISO('2026-09-09T08:00:00').diff(DateTime.fromISO($json.scan_at), 'days').days) : -1) >= 2 || ($json.shipped_at ? Math.max(0, Math.floor(DateTime.fromISO('2026-09-09T08:00:00').diff(DateTime.fromISO($json.shipped_at), 'days').days) - $json.service_days) : 0) >= 1)) ? 'Not sure' : 'Moving normally' }}"
            },
            {
              "id": "a9",
              "name": "why",
              "type": "string",
              "value": "={{ ($json.fulfilled && !$json.scan_at && !!$json.snap_scan_at) ? 'The courier reported on this order yesterday and returned no record at all today.' : (!$json.fulfilled && Math.floor(DateTime.fromISO('2026-09-09T08:00:00').diff(DateTime.fromISO($json.placed_at), 'days').days) > $json.handover_days) ? ('Paid ' + Math.floor(DateTime.fromISO('2026-09-09T08:00:00').diff(DateTime.fromISO($json.placed_at), 'days').days) + ' days ago and the warehouse has still not handed it to a courier.') : (!!$json.scan_at && ($json.scan_at ? Math.floor(DateTime.fromISO('2026-09-09T08:00:00').diff(DateTime.fromISO($json.scan_at), 'days').days) : -1) >= 4) ? ('No scan for ' + ($json.scan_at ? Math.floor(DateTime.fromISO('2026-09-09T08:00:00').diff(DateTime.fromISO($json.scan_at), 'days').days) : -1) + ' days - last seen as ' + $json.scan_status + ' at ' + $json.scan_location + '.') : (($json.shipped_at ? Math.max(0, Math.floor(DateTime.fromISO('2026-09-09T08:00:00').diff(DateTime.fromISO($json.shipped_at), 'days').days) - $json.service_days) : 0) >= 3) ? ('Still moving, but ' + ($json.shipped_at ? Math.max(0, Math.floor(DateTime.fromISO('2026-09-09T08:00:00').diff(DateTime.fromISO($json.shipped_at), 'days').days) - $json.service_days) : 0) + ' days past the ' + $json.service_days + '-day service standard for ' + $json.zone + '.') : (($json.quoted_shipping > 0 && $json.invoiced_shipping ? Math.round(($json.invoiced_shipping / $json.quoted_shipping) * 100) / 100 : 0) >= 1.4) ? ('Invoiced ' + $json.invoiced_shipping + ' against a quoted ' + $json.quoted_shipping + ' - ' + ($json.quoted_shipping > 0 && $json.invoiced_shipping ? Math.round(($json.invoiced_shipping / $json.quoted_shipping) * 100) / 100 : 0) + ' times the rate for ' + $json.weight_kg + 'kg to ' + $json.zone + '.') : ('Quiet for ' + ($json.scan_at ? Math.floor(DateTime.fromISO('2026-09-09T08:00:00').diff(DateTime.fromISO($json.scan_at), 'days').days) : -1) + ' days and ' + ($json.shipped_at ? Math.max(0, Math.floor(DateTime.fromISO('2026-09-09T08:00:00').diff(DateTime.fromISO($json.shipped_at), 'days').days) - $json.service_days) : 0) + ' days past the service standard - normal on this lane, but worth a look.') }}"
            },
            {
              "id": "a10",
              "name": "severity",
              "type": "number",
              "value": "={{ (!($json.fulfilled && !$json.scan_at && !!$json.snap_scan_at) && ((!$json.fulfilled && Math.floor(DateTime.fromISO('2026-09-09T08:00:00').diff(DateTime.fromISO($json.placed_at), 'days').days) > $json.handover_days) || (!!$json.scan_at && ($json.scan_at ? Math.floor(DateTime.fromISO('2026-09-09T08:00:00').diff(DateTime.fromISO($json.scan_at), 'days').days) : -1) >= 4) || (($json.shipped_at ? Math.max(0, Math.floor(DateTime.fromISO('2026-09-09T08:00:00').diff(DateTime.fromISO($json.shipped_at), 'days').days) - $json.service_days) : 0) >= 3))) ? 3 : (($json.quoted_shipping > 0 && $json.invoiced_shipping ? Math.round(($json.invoiced_shipping / $json.quoted_shipping) * 100) / 100 : 0) >= 1.4) ? 2 : (!($json.fulfilled && !$json.scan_at && !!$json.snap_scan_at) && !(!($json.fulfilled && !$json.scan_at && !!$json.snap_scan_at) && ((!$json.fulfilled && Math.floor(DateTime.fromISO('2026-09-09T08:00:00').diff(DateTime.fromISO($json.placed_at), 'days').days) > $json.handover_days) || (!!$json.scan_at && ($json.scan_at ? Math.floor(DateTime.fromISO('2026-09-09T08:00:00').diff(DateTime.fromISO($json.scan_at), 'days').days) : -1) >= 4) || (($json.shipped_at ? Math.max(0, Math.floor(DateTime.fromISO('2026-09-09T08:00:00').diff(DateTime.fromISO($json.shipped_at), 'days').days) - $json.service_days) : 0) >= 3))) && !(($json.quoted_shipping > 0 && $json.invoiced_shipping ? Math.round(($json.invoiced_shipping / $json.quoted_shipping) * 100) / 100 : 0) >= 1.4) && (($json.scan_at ? Math.floor(DateTime.fromISO('2026-09-09T08:00:00').diff(DateTime.fromISO($json.scan_at), 'days').days) : -1) >= 2 || ($json.shipped_at ? Math.max(0, Math.floor(DateTime.fromISO('2026-09-09T08:00:00').diff(DateTime.fromISO($json.shipped_at), 'days').days) - $json.service_days) : 0) >= 1)) ? 1 : 0 }}"
            }
          ]
        },
        "options": {}
      },
